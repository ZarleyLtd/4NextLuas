# Copy to .env and fill in. Never commit .env.

# NTA GTFS-Realtime subscription key (developer.nationaltransport.ie -> Profile -> primary key)
# Prefer a second key so this skill does not share the 1 request / 60s budget with 4NextBus.
NTA_API_KEY=

# Station used by the local PoC
POC_STATION=Dundrum
POC_DIRECTION=northbound

# AWS (only needed for ingest / deploy from this PC)
AWS_REGION=eu-west-1
AWS_PROFILE=default
FOURNEXTLUAS_TABLE=FourNextLuas

# Deploy inputs (tools/deploy.py stack)
# One skill ID, or two comma-separated (e.g. the live skill and a development copy)
ALEXA_SKILL_ID=
ALERT_EMAIL=
